# BrightPattern-Audit — Environment variables for VPS Flask backend
# Copy to .env and fill in values. Never commit .env.

# PHP proxy URL on DreamHost (handles MySQL reads/writes)
BP_PROXY_URL=https://xi-app.pro/brightpattern/brightpattern_db.php

# Shared secret between Flask and the PHP proxy
BP_PROXY_SECRET=change_me_strong_random_string

# Optional API key to protect Flask endpoints (leave blank to disable)
BP_API_KEY=

# Port the Flask server listens on
BP_PORT=8090

# Comma-separated origins allowed for CORS
ALLOWED_ORIGINS=https://xi-app.pro

FLASK_DEBUG=0
